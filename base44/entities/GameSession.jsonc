{
  "name": "GameSession",
  "type": "object",
  "properties": {
    "round_id": {
      "type": "string",
      "description": "Round played (empty for marathon sessions, which sample from round_ids instead)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "solo",
        "multiplayer"
      ]
    },
    "game_type": {
      "type": "string",
      "enum": [
        "standard",
        "marathon"
      ],
      "default": "standard",
      "description": "Marathon sessions are endless: clients derive an identical infinite question sequence from seed + round_ids + subject_freq"
    },
    "room_code": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "active",
        "finished"
      ],
      "default": "waiting"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Public rooms are listed in the multiplayer lobby's public games browser"
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "Host-controlled: when true, no new players may join (existing players are unaffected)"
    },
    "seed": {
      "type": "number",
      "description": "Marathon only — PRNG seed shared by all clients for deterministic question sampling"
    },
    "round_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Marathon only — rounds in the sampling pool (empty = all rounds)"
    },
    "round_filter": {
      "type": "string",
      "enum": ["all", "RR", "DE"],
      "description": "Marathon only — restrict pool to Round Robin / Double Elim packets"
    },
    "subject_freq": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Marathon only — per-subject weight percent (0–100), normalized into sampling shares"
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "default": 0
          },
          "team": {
            "type": "string",
            "default": ""
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "teams": {
      "type": "array",
      "description": "Team definitions",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "captain_id": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "current_question_index": {
      "type": "number",
      "default": 0
    },
    "buzz_state": {
      "type": "object",
      "description": "Shared buzz state for the current question",
      "properties": {
        "buzzed_player_id": {
          "type": "string"
        },
        "buzzed_team": {
          "type": "string"
        },
        "buzzed_display_name": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "question_dead": {
          "type": "boolean",
          "default": false
        },
        "dead": {
          "type": "boolean",
          "default": false,
          "description": "Nobody can win the question any more — timed out, everyone missed it, or it hit its wrong-answer limit"
        },
        "pending_buzz": {
          "type": "object",
          "description": "Provisional lock: a claim that has reached the server but not yet cleared arbitration. Broadcast immediately so every screen locks a network hop after the buzz; replaced by buzzed_player_id when the window closes",
          "properties": {
            "player_id": { "type": "string" },
            "team": { "type": "string" },
            "display_name": { "type": "string" },
            "buzzed_at": { "type": "number" }
          }
        },
        "dead_reason": {
          "type": "string",
          "description": "timeout | all_answered | wrong_limit"
        },
        "wrong_count": {
          "type": "number",
          "default": 0,
          "description": "Wrong answers taken on this tossup"
        },
        "wrong_limit": {
          "type": "number",
          "description": "Wrong answers that kill it: 2 for Multiple Choice, 3 for Short Answer"
        },
        "question_format": {
          "type": "string",
          "description": "Format of the current question, reported by the answering client (the server holds no question list)"
        },
        "bonus_for_team": {
          "type": "string"
        },
        "bonus_for_player": {
          "type": "string"
        },
        "negged_teams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chat_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sender_id": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "ts": {
            "type": "string"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "read_aloud": {
          "type": "boolean",
          "default": false
        },
        "wpm": {
          "type": "number",
          "default": 200
        },
        "answer_time": {
          "type": "number",
          "default": 5
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "question_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skip_bonuses": {
          "type": "boolean",
          "default": false
        },
        "powers": {
          "type": "boolean",
          "default": false,
          "description": "House rule: a correct interrupt scores +6 instead of +4. Scored server-side (server/match.js)"
        },
        "boss_ups": {
          "type": "boolean",
          "default": false,
          "description": "House rule: bonuses are read as open tossups (tossup scoring, interrupts allowed, +10s to buzz). Applied client-side by rewriting the question type — the server just sees tossups"
        }
      }
    },
    "question_results": {
      "type": "array",
      "description": "Points log. Each entry: question_index, player, team, kind, points, type, interrupted, submitted_answer, submitted_choice, ts",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "round_id",
    "mode"
  ]
}