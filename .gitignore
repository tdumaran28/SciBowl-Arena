# Secrets — .env.local holds the Clerk secret key and the Supabase service-role
# key. Only the placeholder template (.env.local.example) belongs in git.
.env
.env.*
!.env.local.example

node_modules/
.next/
out/

# Uploaded packet files (served from /uploads when Supabase Storage is unused)
server/uploads/

# Local JSON datastore. Runtime state, not source: it holds live game sessions
# (with player emails), and it is read at startup — so a committed copy ships
# your local rooms to production and puts real addresses in git history.
server/data/

.DS_Store
*.log
